// Azure Cloud Monitoring: standalone queries.
// IMPORTANT: Run ONE numbered query at a time in Logs / Kusto Explorer.
// Resource data uses Date_s (event day) when available, instead of TimeGenerated
// (which may be the ingestion time for synthetic/backfilled records).
// column_ifexists bridges legacy _s/_d columns and DCR-defined column names.
// Check real column names with: AzureCostData_CL | getschema

// =====================================================================
// QUERY 1: Ingestion verification
// =====================================================================
AzureCostData_CL
| summarize Records=count(), FirstIngest=min(TimeGenerated), LastIngest=max(TimeGenerated)

// =====================================================================
// QUERY 2: Resource-level cost anomaly detection (NO IsAnomaly dependency).
// Each observed day is compared with up to 29 prior calendar days.
// Require 7 observed baseline days and both percentage/absolute thresholds.
// This scans historical events, including synthetic mid-month spikes.
// For a real alert, additionally filter Day to today's/recent days.
// =====================================================================
let CostThresholdPct = 30.0;
let CostThresholdAbs = 5.0;
let DailyResourceSpend = materialize(
    AzureCostData_CL
    | extend Day = startofday(todatetime(column_ifexists("Date_s", column_ifexists("Date", "")))),
             ResourceName = tostring(column_ifexists("ResourceName_s", column_ifexists("ResourceName", ""))),
             ResourceType = tostring(column_ifexists("ResourceType_s", column_ifexists("ResourceType", ""))),
             ResourceGroupName = tostring(column_ifexists("ResourceGroup_s", column_ifexists("ResourceGroup", ""))),
             Cost = todouble(column_ifexists("DailyCost_d", column_ifexists("DailyCost", real(null))))
    | where isnotnull(Day) and isnotnull(Cost) and isnotempty(ResourceName)
    | summarize DailySpend = sum(Cost) by ResourceGroupName, ResourceType, ResourceName, Day
);
let PriorResourceDays = DailyResourceSpend
    | project ResourceGroupName, ResourceType, ResourceName,
              PreviousDay=Day, PreviousSpend=DailySpend;
DailyResourceSpend
| join kind=inner PriorResourceDays on ResourceGroupName, ResourceType, ResourceName
| where PreviousDay >= Day-29d and PreviousDay < Day
| summarize BaselineDays=count(),
            AvgDailyResourceCost=avg(PreviousSpend),
            StdDevDailyCost=stdev(PreviousSpend)
    by ResourceGroupName, ResourceType, ResourceName, Day, DailySpend
| where BaselineDays >= 7 and AvgDailyResourceCost > 0
| extend CostIncrease = DailySpend - AvgDailyResourceCost
| extend PercentageIncrease = 100.0 * CostIncrease / AvgDailyResourceCost
| where CostIncrease > CostThresholdAbs and PercentageIncrease > CostThresholdPct
| extend DeviationsFromNormal = iff(StdDevDailyCost > 0.0,
                                     CostIncrease / StdDevDailyCost, real(null))
| project Day, ResourceGroupName, ResourceName, ResourceType,
          TodayCost=round(DailySpend,2),
          AvgDailyResourceCost=round(AvgDailyResourceCost,2),
          CostIncrease=round(CostIncrease,2),
          PercentageIncrease=round(PercentageIncrease,2),
          DeviationsFromNormal=round(DeviationsFromNormal,2), BaselineDays
| order by Day desc, CostIncrease desc

// =====================================================================
// QUERY 3: Daily spend trend. Baseline is the mean of observed daily
// totals (not a hardcoded 29-day divisor; no synthetic anomaly label).
// =====================================================================
let DailyTotals = materialize(
    AzureCostData_CL
    | extend Day=startofday(todatetime(column_ifexists("Date_s", column_ifexists("Date", "")))),
             Cost=todouble(column_ifexists("DailyCost_d", column_ifexists("DailyCost", real(null))))
    | where isnotnull(Day) and Day between (startofday(ago(30d)) .. startofday(now()))
      and isnotnull(Cost)
    | summarize TotalDailyCost=sum(Cost) by Day
);
let AvgObservedDayCost = toscalar(DailyTotals | summarize avg(TotalDailyCost));
DailyTotals
| extend Baseline=round(AvgObservedDayCost,2),
         PercentageVsBaseline=iff(AvgObservedDayCost > 0.0,
             round(100.0 * (TotalDailyCost-AvgObservedDayCost) / AvgObservedDayCost,2), real(null))
| order by Day asc
| project Day, TotalDailyCost=round(TotalDailyCost,2), Baseline, PercentageVsBaseline

// =====================================================================
// QUERY 4: Top spending resources. Extra "| |" removed.
// Daily averages are computed from aggregated resource-day spend.
// =====================================================================
let ResourceDays =
    AzureCostData_CL
    | extend Day=startofday(todatetime(column_ifexists("Date_s", column_ifexists("Date", "")))),
             ResourceName=tostring(column_ifexists("ResourceName_s", column_ifexists("ResourceName", ""))),
             ResourceType=tostring(column_ifexists("ResourceType_s", column_ifexists("ResourceType", ""))),
             ResourceGroupName=tostring(column_ifexists("ResourceGroup_s", column_ifexists("ResourceGroup", ""))),
             Cost=todouble(column_ifexists("DailyCost_d", column_ifexists("DailyCost", real(null))))
    | where Day between (startofday(ago(30d)) .. startofday(now())) and isnotnull(Cost)
    | summarize DailySpend=sum(Cost) by ResourceName, ResourceType, ResourceGroupName, Day;
ResourceDays
| summarize TotalCost=round(sum(DailySpend),2),
            AvgDailyCost=round(avg(DailySpend),2),
            MaxDailyCost=round(max(DailySpend),2),
            DaysActive=count()
    by ResourceName, ResourceType, ResourceGroupName
| extend MonthlyCostProjection=round(AvgDailyCost*30.0,2)
| extend CostRating=case(AvgDailyCost>50.0,"High",
                         AvgDailyCost>20.0,"Medium","Low")
| order by TotalCost desc
| project ResourceGroupName, ResourceName, ResourceType, TotalCost,
          AvgDailyCost, MaxDailyCost, MonthlyCostProjection, DaysActive, CostRating

// =====================================================================
// QUERY 5: Off-hours administrative changes, local Toronto business time.
// Business hours: Monday-Friday, 08:00 inclusive to 18:00 exclusive.
// Change "America/Toronto" if another locality applies.
// =====================================================================
AzureActivity
| where TimeGenerated > ago(30d)
| where ActivityStatusValue == "Success" and CategoryValue == "Administrative"
| extend LocalTime=datetime_utc_to_local(TimeGenerated, "America/Toronto")
| extend HourOfDay=datetime_part("hour", LocalTime),
         DayOfWeek=dayofweek(LocalTime)
| where HourOfDay < 8 or HourOfDay >= 18 or DayOfWeek == 0d or DayOfWeek == 6d
| summarize ActionCount=count(), Actions=make_set(OperationNameValue, 30),
            FirstLocal=min(LocalTime), LastLocal=max(LocalTime)
    by Caller, ResourceGroup, UtcHour=bin(TimeGenerated,1h)
| order by UtcHour desc
| project UtcHour, FirstLocal, LastLocal, Caller, ResourceGroup, ActionCount, Actions

// =====================================================================
// QUERY 6: 30-day overall compliance trend. Uses the documented table.
// =====================================================================
IntuneComplianceData_CL
| where TimeGenerated > ago(30d)
| summarize TotalChecks=count(), CompliantChecks=countif(IsCompliant_b == true)
    by Date_s
| extend ComplianceRatePct=round(100.0*todouble(CompliantChecks)/TotalChecks,2)
| order by Date_s asc

// =====================================================================
// QUERY 7: Non-compliant checks by department.
// =====================================================================
IntuneComplianceData_CL
| where TimeGenerated > ago(30d) and IsCompliant_b == false
| summarize ViolationChecks=count(), AffectedDevices=dcount(DeviceName_s),
            FailedPolicies=make_set(PolicyName_s,30)
    by Department_s, OperatingSystem_s
| order by ViolationChecks desc

// =====================================================================
// QUERY 8: Synthetic compliance drift events (generator labels drift).
// =====================================================================
IntuneComplianceData_CL
| where TimeGenerated > ago(30d) and IsComplianceDrift_b == true
| summarize DriftEvents=count(), AffectedDevices=make_set(DeviceName_s,50)
    by Date_s, Department_s, PolicyName_s
| order by Date_s desc

// =====================================================================
// QUERY 9: Pod health based on LATEST snapshot per pod, not every sample.
// =====================================================================
KubePodInventory
| where TimeGenerated > ago(1h)
| summarize arg_max(TimeGenerated, PodStatus) by ClusterName, Namespace, Name
| summarize TotalPods=count(), RunningPods=countif(PodStatus=="Running"),
            FailedPods=countif(PodStatus=="Failed"), PendingPods=countif(PodStatus=="Pending")
    by ClusterName, Namespace
| extend HealthScore=round(100.0*todouble(RunningPods)/TotalPods,2)
| order by HealthScore asc

// =====================================================================
// QUERY 10: Node health based on latest snapshot; "NotReady" must NOT
// be counted as Ready (so do not use contains "Ready").
// =====================================================================
KubeNodeInventory
| where TimeGenerated > ago(1h)
| summarize arg_max(TimeGenerated, Status) by ClusterName, Computer
| summarize TotalNodes=count(), ReadyNodes=countif(Status=="Ready") by ClusterName
| extend NodeHealthPct=round(100.0*todouble(ReadyNodes)/TotalNodes,2)

// =====================================================================
// QUERY 11: Restarts -- difference between earliest and latest counter
// snapshots for each named pod/container, NOT sum of snapshot counters.
// Note: restarts during counter resets / pod recreation may be undercounted.
// =====================================================================
KubePodInventory
| where TimeGenerated > ago(7d) and isnotempty(ContainerName)
| summarize FirstRestartCount=arg_min(TimeGenerated, ContainerRestartCount),
            LastRestartCount=arg_max(TimeGenerated, ContainerRestartCount),
            Samples=count()
    by ClusterName, Namespace, Name, ContainerName
| where Samples >= 2
| extend RestartsInWindow=max_of(0, tolong(LastRestartCount)-tolong(FirstRestartCount))
| where RestartsInWindow > 0
| summarize TotalRestarts=sum(RestartsInWindow), AffectedPods=dcount(Name)
    by ClusterName, Namespace, ContainerName
| order by TotalRestarts desc

// =====================================================================
// QUERY 12: Namespace workload proxy (NOT true dollar-cost attribution).
// =====================================================================
KubePodInventory
| where TimeGenerated > ago(1h)
| summarize arg_max(TimeGenerated, ContainerName) by ClusterName, Namespace, Name
| summarize PodCount=count(), ContainerSamples=dcount(ContainerName) by ClusterName, Namespace
| order by PodCount desc
