{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Baseline Azure Monitor infrastructure. Custom tables, DCR/DCE, diagnostic settings, and AKS need separate deployment. Cost alert is opt-in."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "workspaceName": {
      "type": "string",
      "defaultValue": "azure-monitor-law"
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[concat('stmon', uniqueString(subscription().id, resourceGroup().id))]",
      "metadata": {
        "description": "Globally unique, lowercase alphanumeric storage account name."
      }
    },
    "actionGroupName": {
      "type": "string",
      "defaultValue": "azure-monitor-ops-ag"
    },
    "notificationEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional email recipient; blank makes an action group without an email receiver."
      }
    },
    "deployCostAlert": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable only when AzureCostData_CL exists and the alert KQL has been validated against the actual schema."
      }
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[parameters('workspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "disableLocalAuth": true,
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true,
        "accessTier": "Hot"
      }
    },
    {
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[parameters('actionGroupName')]",
      "location": "global",
      "properties": {
        "groupShortName": "MonOps",
        "enabled": true,
        "emailReceivers": "[if(empty(parameters('notificationEmail')), json('[]'), createArray(createObject('name', 'OpsEmail', 'emailAddress', parameters('notificationEmail'), 'useCommonAlertSchema', true())))]"
      }
    },
    {
      "condition": "[parameters('deployCostAlert')]",
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "cost-anomaly-demo-alert",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ],
      "properties": {
        "displayName": "Cost anomaly based on historical spend",
        "description": "Lab/example: runs against a populated custom table; use actual cost ingestion for production.",
        "enabled": true,
        "severity": 3,
        "evaluationFrequency": "PT5M",
        "windowSize": "P1D",
        "scopes": [
          "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
        ],
        "autoMitigate": true,
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          ]
        },
        "criteria": {
          "allOf": [
            {
              "query": "let Daily = AzureCostData_CL\n| extend Day = startofday(todatetime(column_ifexists(\"Date_s\", column_ifexists(\"Date\", \"\")))),\n         Resource = tostring(column_ifexists(\"ResourceName_s\", column_ifexists(\"ResourceName\", \"\"))),\n         Group = tostring(column_ifexists(\"ResourceGroup_s\", column_ifexists(\"ResourceGroup\", \"\"))),\n         Cost = todouble(column_ifexists(\"DailyCost_d\", column_ifexists(\"DailyCost\", real(null))))\n| where isnotnull(Day) and isnotnull(Cost)\n| summarize Spend = sum(Cost) by Day, Group, Resource;\nlet Current = Daily\n| where Day >= startofday(ago(1d))\n| summarize arg_max(Day, Spend) by Group, Resource\n| project Group, Resource, CurrentDay=Day, CurrentSpend=Spend;\nlet Previous = Daily\n| join kind=inner (Current | project Group, Resource, CurrentDay) on Group, Resource\n| where Day < CurrentDay and Day >= CurrentDay-29d\n| summarize BaselineDays=count(), Baseline=avg(Spend) by Group, Resource;\nCurrent\n| join kind=inner Previous on Group, Resource\n| where BaselineDays >= 7 and Baseline > 0\n| where CurrentSpend-Baseline > 5.0 and (CurrentSpend-Baseline)/Baseline > 0.30\n| project Group, Resource, CurrentSpend, Baseline",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "workspaceResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
    },
    "actionGroupResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    }
  }
}
